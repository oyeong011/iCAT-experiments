+    serial="$(cat "$ctrl/serial")" || return 1
+    vendor="$(cat "$ctrl/device/vendor")" || return 1
+    address="$(cat "$ctrl/address")" || return 1
+    [[ "$serial" =~ ^CSL_Virt_SN_[0-9]+[[:space:]]*$ && "$vendor" == 0x0c51 && "$address" =~ ^[[:xdigit:]]{4}:10:00\.0$ ]] || return 1
