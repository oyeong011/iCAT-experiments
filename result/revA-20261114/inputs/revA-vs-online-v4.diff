+/* revA-20261114: reproducible per-partition PRNG for the random-selection baseline. */
+static ulong icat_seed = 20261114;
+module_param(icat_seed, ulong, 0444);
+MODULE_PARM_DESC(icat_seed, "revA random-selection seed (per partition: seed mixed with part id)");
+
+static uint64_t watgc_v2_splitmix(uint64_t x)
+{
+	x += 0x9E3779B97F4A7C15ULL;
+	x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ULL;
+	x = (x ^ (x >> 27)) * 0x94D049BB133111EBULL;
+	return x ^ (x >> 31);
+}
+
+static __maybe_unused uint32_t watgc_v2_random_arm(struct watgc_v2_tuner *t)
+{
+	uint64_t x = t->rng;	/* xorshift64* */
+
+	x ^= x >> 12;
+	x ^= x << 25;
+	x ^= x >> 27;
+	t->rng = x;
+	return WATGC_V2_ARM_LO +
+	       (uint32_t)((x * 0x2545F4914F6CDD1DULL) >> 32) %
+	       (WATGC_V2_ARM_N - WATGC_V2_ARM_LO);
+}
