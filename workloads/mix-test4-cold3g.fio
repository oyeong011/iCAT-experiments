[global]
filename=${FIO_TARGET}
ioengine=libaio
direct=1
rw=randwrite
bs=4K
iodepth=32
iodepth_batch_submit=1
time_based=0
allow_file_create=0
overwrite=1
randrepeat=1
end_fsync=1

[hot]
offset=0
size=512M
io_size=${HOT_IO}
rate_iops=24000
randseed=${SEED_HOT}

[warm]
offset=512M
size=1536M
io_size=${WARM_IO}
rate_iops=12000
randseed=${SEED_WARM}

[cold]
offset=2G
size=3G
io_size=${COLD_IO}
rate_iops=4000
randseed=${SEED_COLD}
