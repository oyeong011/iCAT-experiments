# Non-stationary phase workload: short-lived -> long-lived mix -> short-lived.
# Phases run back to back on one device (stonewall), so the FTL sees a single
# stream whose update time scale changes twice.
#   P1  1 GiB uniform random, 8,000 IOPS -> every page rewritten about every 33 s
#   P2  1 GiB hot (33 s) + 5 GiB cold (655 s) -> long-lived data enters the mix
#   P3  = P1
[global]
filename=${FIO_TARGET}
ioengine=libaio
direct=1
rw=randwrite
bs=4K
iodepth=32
iodepth_batch_submit=1
time_based=1
runtime=${FIO_PHASE_RUNTIME}
allow_file_create=0
overwrite=1
randrepeat=1
group_reporting=0

[p1-uniform]
stonewall
offset=0
size=1G
rate_iops=8000
randseed=20260904

[p2-hot]
stonewall
offset=0
size=1G
rate_iops=8000
randseed=20260905

[p2-cold]
offset=1G
size=5G
rate_iops=2000
randseed=20260906

[p3-uniform]
stonewall
offset=0
size=1G
rate_iops=8000
randseed=20260907
