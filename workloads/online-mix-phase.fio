[global]
filename=${FIO_TARGET}
ioengine=libaio
direct=1
rw=randwrite
bs=4K
iodepth=32
iodepth_batch_submit=1
time_based=1
runtime=${PHASE_SECONDS}
allow_file_create=0
overwrite=1
randrepeat=1
end_fsync=1

[front]
offset=0
size=2G
rate_iops=${FRONT_IOPS}
randseed=${FRONT_SEED}

[back]
offset=2G
size=4G
rate_iops=${BACK_IOPS}
randseed=${BACK_SEED}
