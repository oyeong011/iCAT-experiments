[global]
filename=${FIO_TARGET}
ioengine=libaio
direct=1
rw=randwrite
bs=4K
iodepth=32
iodepth_batch_submit=1
time_based=0
allow_file_create=0
overwrite=1
randrepeat=1
end_fsync=1

[hot]
offset=0
size=1G
io_size=19660800000
rate_iops=8000
randseed=${SEED_HOT}

[cold]
offset=1G
size=5G
io_size=4915200000
rate_iops=2000
randseed=${SEED_COLD}
